{
  "name": "application",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "description": "Electron Application",
  "author": {
    "name": "SSymbol"
  },
  "scripts": {
    "dev": "pnpm electron-rebuild && vite",
    "build": "pnpm run lint && pnpm run type && vue-tsc && pnpm electron-rebuild && vite build && electron-builder",
    "type": "tsc -p tsconfig.types.json --incremental false && tsc-alias -p tsconfig.json",
    "lint": "prettier --write \"src/**/*.{ts,vue,css}\" && eslint . --ext .ts,.vue --fix"
  },
  "build": {
    "asar": true,
    "appId": "com.github.ssymbo1.application",
    "productName": "Application",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist-electron",
      "dist"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "better-sqlite3": "^11",
    "electron-log": "^5.4.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25",
    "valve-key-values-binary": "^1.0.1",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "~4.2.6",
    "unplugin-vue-components": "^29.0.0",
    "globals": "^16.3.0",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.15",
    "@types/winreg": "^1.2.36",
    "@vitejs/plugin-vue": "^6.0.0",
    "depcheck": "^1.4.7",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-squirrel-startup": "^1.0.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-native": "^2.2.2",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.12"
  }

}