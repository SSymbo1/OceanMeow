{
  "name": "oceanmeow",
  "private": true,
  "version": "0.5.0",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "description": "Electron Application",
  "homepage": "https://github.com/SSymbo1/OceanMeow",
  "lastest": "https://github.com/SSymbo1/OceanMeow/releases/latest",
  "author": {
    "name": "SSymbol",
    "email": "SS_ymbol@outlook.com"
  },
  "scripts": {
    "dev:electron": "tsx scripts/development-server.js --electron",
    "dev:website": "tsx scripts/development-server.js --website",
    "build:electron": "tsx scripts/prod-build.js --electron",
    "build:website": "tsx scripts/prod-build.js --website",
    "generate:type": "tsx scripts/type-generate.js",
    "generate:config": "tsx scripts/config-serialize.js --dev",
    "generate:database": "electron scripts/database-create.mjs --dev",
    "preview:website": "tsx scripts/development-server.js --preview",
    "project:init": "tsx scripts/project-init.js",
    "lint": "tsx scripts/project-quality.js --lint",
    "test": "tsx scripts/project-quality.js --test"
  },
  "build": {
    "asar": true,
    "appId": "com.github.ssymbo1.oceanmeow",
    "productName": "OceanMeow",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist-electron",
      "dist"
    ],
    "extraResources": [
      {
        "from": "public/prod",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/icon.ico",
        "to": "."
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "better-sqlite3": "^11",
    "electron-log": "^5.4.1",
    "hono": "^4.9.2",
    "json-stable-stringify": "^1.3.0",
    "p-limit": "^7.1.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.4",
    "typeorm": "^0.3.25",
    "valve-key-values-binary": "^1.0.1",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "vue3-count-to": "^1.1.2",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.33.0",
    "@hono/node-server": "^1.19.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.15",
    "@types/winreg": "^1.2.36",
    "@vitejs/plugin-vue": "^6.0.0",
    "ant-design-vue": "~4.2.6",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.4.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-native": "^2.2.2",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.12"
  }
}
