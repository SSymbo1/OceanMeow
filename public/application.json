{
  "common": {
    "theme": "2",
    "defaultHome": "1",
    "defaultLanguage": "2"
  },
  "library": {
    "libraryShow": "0",
    "librarySort": "2",
    "librarySortOrder": false,
    "screenSortOrder": false,
    "libraryCoverInfo": "0",
    "defaultScreenDumpPath": "E:\\",
    "defaultScreenCreateFolder": true,
    "defaultScreenDateOrdered": false,
    "defaultScreenForderType": "0"
  },
  "logger": {
    "fileLevel": "info",
    "consoleLevel": "info",
    "format": "[{y}-{m}-{d} {h}:{i}:{s}.{ms}] [{level}] {scope} >>> {text}",
    "logName": "/logs/application_${date}.log",
    "maxSize": 1002430
  }
}